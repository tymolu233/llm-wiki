{
  "name": "@tymolu/llmwiki",
  "version": "0.1.0-beta.6",
  "description": "Agent-First personal knowledge base engine compiled by LLMs, browsed in Obsidian, VS Code, or any markdown editor.",
  "type": "module",
  "bin": {
    "llmwiki": "bin/llmwiki.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tymolu233/llm-wiki.git"
  },
  "homepage": "https://github.com/tymolu233/llm-wiki#readme",
  "bugs": {
    "url": "https://github.com/tymolu233/llm-wiki/issues"
  },
  "keywords": [
    "llm",
    "wiki",
    "obsidian",
    "knowledge-base",
    "agent",
    "mcp",
    "karpathy"
  ],
  "author": "tymolu233",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "gray-matter": "^4.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
